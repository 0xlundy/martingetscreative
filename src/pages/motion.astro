---
// Motion: the reel, one full screen. Nothing else.
import BaseLayout from '../layouts/BaseLayout.astro';

// The reel is self-hosted: WebM for Chrome/Firefox/Edge, MP4 for Safari/iOS.
// Plays on arrival, muted (browsers only allow silent autoplay); viewers unmute in the player.
import NativeVideo from '../components/NativeVideo.astro';
const REEL = {
  mp4: '/videos/cinematography-reel-2026.mp4',
  webm: '/videos/cinematography-reel-2026.webm',
  poster: '/videos/cinematography-reel-2026-poster.jpg',
};
---

<BaseLayout
  title="Motion | Martin Van Londen, Cinematographer, Portland OR"
  description="Cinematography reel by Martin Van Londen, director of photography based in Portland, Oregon. Available worldwide."
>
  <section class="rl-stage">
    <div class="rl-player">
      <div class="rl-frame">
        <NativeVideo mp4={REEL.mp4} webm={REEL.webm} poster={REEL.poster} title="Martin Van Londen Reel" autoplay />
      </div>
    </div>
    <div class="rl-caption">
      <h1>Reel</h1>
      <span>Martin Van Londen — Director of Photography</span>
      <span class="rl-dim">Sound off — use the player to unmute</span>
    </div>
  </section>
</BaseLayout>

<style>
  /* One full screen: the player is as large as the viewport allows at 16:9. */
  .rl-stage {
    min-height: 100svh;
    padding: 76px 5px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
  .rl-player,
  .rl-caption { width: min(100%, calc((100svh - 76px - 60px) * 16 / 9)); }
  .rl-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    background: #000;
  }
  .rl-frame :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .rl-caption {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    color: var(--color-text);
  }
  .rl-caption h1 { font: inherit; }
  .rl-dim { color: var(--color-faint); margin-left: auto; }

  @media (max-width: 899px) {
    .rl-stage { min-height: 70svh; padding-top: 120px; }
    .rl-player, .rl-caption { width: 100%; }
    .rl-caption { padding-inline: 7px; gap: 4px 14px; }
    .rl-dim { margin-left: 0; }
  }
</style>
