---
// Home = the photo index. Every still from src/data/work.ts in one dense grid,
// numbered, with filters that fade (never reshuffle). The reel lives at /reel.
import BaseLayout from '../layouts/BaseLayout.astro';
import { work, categories } from '../data/work';
import { thumb, thumbSrcset } from '../data/thumbs';

const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(categories.map((c) => [c.id, work.filter((w) => w.category === c.id).length]));
const pad = (n: number) => String(n).padStart(3, '0');
const SIZES = '(min-width: 1200px) 20vw, (min-width: 900px) 25vw, 50vw';
---

<BaseLayout
  mono
  title="Cinematographer & Commercial Photographer Portland OR | Martin Van Londen"
  description="Portland, OR cinematographer and commercial photographer with twenty years creating campaign, documentary, and editorial content. Available for projects worldwide."
>
  <section class="ix-head">
    <div class="ix-id">
      <h1>Martin Van Londen</h1>
      <p>Director of Photography + Photographer</p>
      <p>Portland, OR · Available worldwide</p>
      <a href="mailto:martinvanlonden@gmail.com">martinvanlonden@gmail.com</a>
    </div>

    <div class="ix-filters" role="group" aria-label="Filter photos by category">
      <button type="button" class="ix-filter is-active" data-filter="all" aria-pressed="true">
        All <span>{work.length}</span>
      </button>
      {categories.map((c) => (
        <button type="button" class="ix-filter" data-filter={c.id} aria-pressed="false">
          {c.label} <span>{counts[c.id]}</span>
        </button>
      ))}
    </div>
  </section>

  <ol class="ix-grid" id="ix-grid">
    {work.map((w, i) => (
      <li class="ix-cell" data-category={w.category}>
        <button
          type="button"
          class="ix-item"
          data-index={i}
          data-src={w.src}
          data-alt={w.alt}
          data-title={w.title}
          data-desc={w.desc}
          aria-label={`Open ${w.title}, ${w.desc}`}
        >
          <span class="ix-frame">
            <img
              src={thumb(w.src, 480)}
              srcset={thumbSrcset(w.src)}
              sizes={SIZES}
              alt={w.alt}
              loading={i < 8 ? 'eager' : 'lazy'}
              fetchpriority={i < 4 ? 'high' : 'auto'}
              decoding="async"
            />
          </span>
          <span class="ix-meta">
            <span class="ix-num">{pad(i + 1)}</span>
            <span class="ix-title">{w.title}</span>
            <span class="ix-desc">{w.desc}</span>
            <span class="ix-cat">{catLabel[w.category]}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <section class="ix-about">
    <div class="ix-col">
      <p class="ix-label">About</p>
      <p>Twenty years behind the frame. I know what makes a story land, and how to build the shot that gets it there.</p>
      <p>Director, DP, and commercial photographer based in Portland, Oregon. My documentary work has been supported by the Andy Warhol Foundation. On the commercial side, I've shot campaigns and editorial content for clients across the Pacific Northwest and beyond. I think in strategy as much as images. I produce content and direct social, not just shoot and edit.</p>
    </div>
    <div class="ix-col">
      <p class="ix-label">Services</p>
      <ul>
        <li>Cinematography — camera department key creative</li>
        <li>Photography — commercial, editorial, documentary, art direction, retouching</li>
        <li>Editorial — documentary + social editing, post supervision</li>
        <li>Strategy — content production, social direction, campaign planning</li>
      </ul>
    </div>
    <div class="ix-col">
      <p class="ix-label">Motion</p>
      <p><a href="/reel">Watch the reel →</a></p>
      <p><a href="/work">Full work archive →</a></p>
    </div>
  </section>

  <!-- Lightbox: full-size original -->
  <div id="ix-lb" class="ix-lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img class="ix-lb-img" alt="" />
    <div class="ix-lb-bar">
      <span class="ix-lb-count"></span>
      <span class="ix-lb-title"></span>
      <span class="ix-lb-ctrl">
        <button type="button" class="ix-lb-prev" aria-label="Previous photo">Prev</button>
        <button type="button" class="ix-lb-next" aria-label="Next photo">Next</button>
        <button type="button" class="ix-lb-close" aria-label="Close viewer">Close</button>
      </span>
    </div>
  </div>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Martin Van Londen',
  jobTitle: 'Cinematographer & Commercial Photographer',
  url: 'https://martingetscreative.com',
  email: 'martinvanlonden@gmail.com',
  description: 'Portland, OR cinematographer and commercial photographer with twenty years of experience creating campaign, documentary, and brand content for global clients.',
  address: { '@type': 'PostalAddress', addressLocality: 'Portland', addressRegion: 'OR', addressCountry: 'US' },
  knowsAbout: ['Commercial Photography', 'Cinematography', 'Documentary Photography', 'Campaign Photography', 'Photo Direction', 'Video Production', 'Content Production', 'Social Media Direction', 'Post Production', 'Creative Strategy'],
})} />

<script>
  const grid = document.getElementById('ix-grid');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.ix-cell'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.ix-filter'));
  const valid = ['all', 'editorial', 'commissioned', 'street', 'conceptual'];
  let active = 'all';

  // Filtering fades non-matching photos in place; the grid never moves.
  function setFilter(f: string, updateHash = true) {
    active = valid.includes(f) ? f : 'all';
    cells.forEach((c) => c.classList.toggle('is-dim', active !== 'all' && c.dataset.category !== active));
    filters.forEach((b) => {
      const on = b.dataset.filter === active;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (updateHash) history.replaceState(null, '', active === 'all' ? location.pathname : '#' + active);
  }
  filters.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.filter || 'all')));
  setFilter(location.hash.slice(1) || 'all', false);

  // ─── Lightbox ───────────────────────────────────
  const lb = document.getElementById('ix-lb') as HTMLElement;
  const lbImg = lb.querySelector('.ix-lb-img') as HTMLImageElement;
  const lbTitle = lb.querySelector('.ix-lb-title') as HTMLElement;
  const lbCount = lb.querySelector('.ix-lb-count') as HTMLElement;
  let order: HTMLElement[] = [];
  let pos = -1;
  let opener: HTMLElement | null = null;

  const items = () =>
    cells.filter((c) => !c.classList.contains('is-dim')).map((c) => c.querySelector('.ix-item') as HTMLElement);

  function show(i: number) {
    pos = (i + order.length) % order.length;
    const el = order[pos];
    lbImg.src = el.dataset.src || '';
    lbImg.alt = el.dataset.alt || '';
    lbTitle.textContent = `${el.dataset.title} — ${el.dataset.desc}`;
    lbCount.textContent = `${String(pos + 1).padStart(3, '0')} / ${String(order.length).padStart(3, '0')}`;
  }
  function open(el: HTMLElement) {
    order = items();
    opener = el;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    show(order.indexOf(el));
    (lb.querySelector('.ix-lb-close') as HTMLElement).focus();
  }
  function close() {
    lb.hidden = true;
    lbImg.removeAttribute('src');
    document.body.style.overflow = '';
    opener?.focus();
  }

  grid?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.ix-item');
    if (!el || el.closest('.is-dim')) return;
    open(el);
  });
  lb.querySelector('.ix-lb-prev')?.addEventListener('click', () => show(pos - 1));
  lb.querySelector('.ix-lb-next')?.addEventListener('click', () => show(pos + 1));
  lb.querySelector('.ix-lb-close')?.addEventListener('click', close);
  lbImg.addEventListener('click', () => show(pos + 1));
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(pos + 1);
    if (e.key === 'ArrowLeft') show(pos - 1);
  });

  // Swipe on phones
  let x0: number | null = null;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(pos + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>

<style>
  /* ─── Head ───────────────────────────────────── */
  .ix-head {
    padding: 88px 5px 20px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
    align-items: end;
  }
  .ix-id h1 { font: inherit; font-weight: 500; color: var(--color-text); }
  .ix-id p, .ix-id a { color: var(--color-muted); }
  .ix-id a:hover { color: var(--color-text); }

  .ix-filters {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    justify-content: flex-end;
  }
  .ix-filter {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    background: none;
    border: 0;
    padding: 4px 0;
    color: var(--color-muted);
    cursor: pointer;
  }
  .ix-filter span { color: var(--color-faint); margin-left: 2px; }
  .ix-filter:hover { color: var(--color-text); }
  .ix-filter.is-active { color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }

  /* ─── Grid ───────────────────────────────────── */
  .ix-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px 5px;
    padding: 0 5px;
  }
  @media (min-width: 1200px) { .ix-grid { grid-template-columns: repeat(5, 1fr); } }

  .ix-cell { position: relative; }

  .ix-item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: zoom-in;
  }

  .ix-frame {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .ix-frame img { width: 100%; height: 100%; object-fit: cover; }

  .ix-meta {
    display: grid;
    grid-template-columns: 3.2em 1fr auto;
    column-gap: 6px;
    padding: 6px 10px 0 0;
    font-size: 10.5px;
    line-height: 1.45;
  }
  .ix-num   { color: var(--color-faint); grid-row: span 2; }
  .ix-title { color: var(--color-text); }
  .ix-cat   { color: var(--color-faint); grid-column: 3; grid-row: 1; }
  .ix-desc  { color: var(--color-muted); grid-column: 2 / -1; }

  .ix-item:hover .ix-title,
  .ix-item:focus-visible .ix-title { text-decoration: underline; text-underline-offset: 3px; }

  /* Filter fade: dimmed photos keep their place under a page-colored veil. */
  .ix-cell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }
  .ix-cell.is-dim::after { opacity: 0.86; pointer-events: auto; }
  .ix-cell.is-dim .ix-item { cursor: default; }

  /* ─── About (below the work) ─────────────────── */
  .ix-about {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 5px;
    padding: 72px 5px 0;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .ix-about .ix-col:first-child { grid-column: span 2; padding-right: 2rem; }
  .ix-about p + p { margin-top: 0.8em; }
  .ix-about ul { list-style: none; }
  .ix-about li + li { margin-top: 0.4em; }
  .ix-label { color: var(--color-faint); margin-bottom: 0.8em; }
  .ix-about a { color: var(--color-text); }
  .ix-about a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ─── Lightbox ───────────────────────────────── */
  .ix-lb {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--color-bg);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .ix-lb[hidden] { display: none; }
  .ix-lb-img {
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 16px 16px 0;
    cursor: e-resize;
  }
  .ix-lb-bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    padding: 12px 16px 16px;
    color: var(--color-muted);
  }
  .ix-lb-title { color: var(--color-text); }
  .ix-lb-ctrl { display: flex; gap: 16px; }
  .ix-lb-ctrl button {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-muted);
    cursor: pointer;
  }
  .ix-lb-ctrl button:hover { color: var(--color-text); }

  /* ─── Phones ─────────────────────────────────── */
  @media (max-width: 899px) {
    .ix-head { grid-template-columns: 1fr; gap: 14px; padding-top: 80px; }
    .ix-filters { grid-column: auto; justify-content: flex-start; gap: 2px 14px; }
    .ix-grid { grid-template-columns: repeat(2, 1fr); gap: 12px 5px; }
    .ix-meta { grid-template-columns: 2.8em 1fr; font-size: 10px; }
    .ix-cat { display: none; }
    .ix-about { grid-template-columns: 1fr; padding: 56px 12px 0; }
    .ix-about .ix-col:first-child { grid-column: auto; padding-right: 0; }
    .ix-lb-bar { grid-template-columns: 1fr auto; }
    .ix-lb-title { grid-column: 1 / -1; grid-row: 2; }
    .ix-lb-img { padding: 8px 0 0; }
  }
</style>
