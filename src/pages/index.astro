---
// Home = Stills: every photo from src/data/work.ts in one dense numbered grid.
// Shoots stay together; single shots fill the gaps; filters show one category.
import BaseLayout from '../layouts/BaseLayout.astro';
import { work, categories } from '../data/work';
import { thumb, thumbSrcset } from '../data/thumbs';

const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(categories.map((c) => [c.id, work.filter((w) => w.category === c.id).length]));
const pad2 = (n: number) => String(n).padStart(2, '0');

// Each shoot is a group (kept together on one row); a photo with no shoot is a
// "single" and gets used to fill the empty end of a row. The browser does the
// packing (see the script below) so it adapts to 5, 4 or 2 columns.
const cells = work.map((w, i) => ({
  w,
  i,
  group: w.shoot ? `${w.category}:${w.shoot}` : `single:${i}`,
  single: !w.shoot || work.filter((x) => x.shoot === w.shoot && x.category === w.category).length === 1,
}));
const SIZES = '(min-width: 1200px) 20vw, (min-width: 900px) 25vw, 50vw';
---

<BaseLayout
  mono
  title="Cinematographer & Commercial Photographer Portland OR | Martin Van Londen"
  description="Portland, OR cinematographer and commercial photographer with twenty years creating campaign, documentary, and editorial content. Available for projects worldwide."
>
  <!-- Intro: the MGC title card, which then flies into the header logo.
       Hidden unless the inline script below turns it on (once per visit). -->
  <script is:inline>
    try {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && !sessionStorage.getItem('mgc-intro')) document.documentElement.classList.add('play-intro');
    } catch (e) {}
  </script>
  <div class="intro" id="intro" aria-hidden="true">
    <div class="intro-bg"></div>
    <div class="intro-card">
      <span class="intro-mgc" id="intro-mgc">MGC</span>
      <span class="intro-rule"></span>
      <span class="intro-sub">Martin Gets Creative</span>
    </div>
  </div>

  <section class="ix-head">
    <div class="ix-bio">
      <h1 class="ix-lead">Twenty years behind the frame. I know what makes a story land, and how to build the shot that gets it there.</h1>
      <p class="ix-sub">
        <span>Portland, Oregon</span>
        <span>Documentary work supported by the Andy Warhol Foundation</span>
        <a href="mailto:martinvanlonden@gmail.com">martinvanlonden@gmail.com</a>
      </p>
      <p class="ix-avail"><span class="ix-dot" aria-hidden="true"></span>Available worldwide</p>
    </div>

    <div class="ix-filters" role="group" aria-label="Filter photos by category">
      <button type="button" class="ix-filter is-active" data-filter="all" aria-pressed="true">
        All <span>{work.length}</span>
      </button>
      {categories.map((c) => (
        <button type="button" class="ix-filter" data-filter={c.id} aria-pressed="false">
          {c.label} <span>{counts[c.id]}</span>
        </button>
      ))}
    </div>
  </section>

  <ol class="ix-grid" id="ix-grid">
    {cells.map(({ w, i, group, single }) => (
      <li class="ix-cell" data-category={w.category} data-group={group} data-single={single ? '1' : undefined}>
        <button
          type="button"
          class="ix-item"
          data-index={i}
          data-src={w.src}
          data-alt={w.alt}
          data-title={w.title}
          data-desc={w.desc}
          aria-label={`Open ${w.title}, ${w.desc}`}
        >
          <span class="ix-frame">
            <img
              src={thumb(w.src, 480)}
              srcset={thumbSrcset(w.src)}
              sizes={SIZES}
              alt={w.alt}
              loading={i < 8 ? 'eager' : 'lazy'}
              fetchpriority={i < 4 ? 'high' : 'auto'}
              decoding="async"
            />
          </span>
          <span class="ix-meta">
            <span class="ix-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="ix-title">{w.title}</span>
            <span class="ix-desc">{w.desc}</span>
            <span class="ix-cat">{catLabel[w.category]}</span>
          </span>
        </button>
      </li>
    ))}
  </ol>

  <section class="ix-about">
    <div class="ix-col">
      <p class="ix-label">About</p>
      <p>On the commercial side, I've shot campaigns and editorial content for clients across the Pacific Northwest and beyond. I think in strategy as much as images. I produce content and direct social, not just shoot and edit.</p>
    </div>
    <div class="ix-col">
      <p class="ix-label">Services</p>
      <ul>
        <li>Cinematography — camera department key creative</li>
        <li>Photography — commercial, editorial, documentary, art direction, retouching</li>
        <li>Editorial — documentary + social editing, post supervision</li>
        <li>Strategy — content production, social direction, campaign planning</li>
      </ul>
    </div>
    <div class="ix-col">
      <p class="ix-label">More</p>
      <p><a href="/motion">Motion — reel →</a></p>
      <p><a href="/stories">Stories — projects in depth →</a></p>
    </div>
  </section>

  <!-- Lightbox: full-size original -->
  <div id="ix-lb" class="ix-lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <img class="ix-lb-img" alt="" />
    <div class="ix-lb-bar">
      <span class="ix-lb-count"></span>
      <span class="ix-lb-title"></span>
      <span class="ix-lb-ctrl">
        <button type="button" class="ix-lb-prev" aria-label="Previous photo">Prev</button>
        <button type="button" class="ix-lb-next" aria-label="Next photo">Next</button>
        <button type="button" class="ix-lb-close" aria-label="Close viewer">Close</button>
      </span>
    </div>
  </div>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Martin Van Londen',
  jobTitle: 'Cinematographer & Commercial Photographer',
  url: 'https://martingetscreative.com',
  email: 'martinvanlonden@gmail.com',
  description: 'Portland, OR cinematographer and commercial photographer with twenty years of experience creating campaign, documentary, and brand content for global clients.',
  address: { '@type': 'PostalAddress', addressLocality: 'Portland', addressRegion: 'OR', addressCountry: 'US' },
  knowsAbout: ['Commercial Photography', 'Cinematography', 'Documentary Photography', 'Campaign Photography', 'Photo Direction', 'Video Production', 'Content Production', 'Social Media Direction', 'Post Production', 'Creative Strategy'],
})} />

<script>
  const grid = document.getElementById('ix-grid');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.ix-cell'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.ix-filter'));
  const valid = ['all', 'editorial', 'commissioned', 'street', 'conceptual'];
  let active = 'all';

  // ─── Packing ──────────────────────────────────
  // Shoots stay on one row. When the next shoot won't fit in what's left of a
  // row, single shots fill that space; leftover singles go at the end.
  let seq: HTMLElement[] = [];
  const pad2 = (n: number) => String(n).padStart(2, '0');

  function pack() {
    if (!grid) return;
    const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
    const shown = cells.filter((c) => !c.hidden);
    const groups: HTMLElement[][] = [];
    const singles: HTMLElement[] = [];
    const byKey = new Map<string, HTMLElement[]>();
    shown.forEach((c) => {
      if (c.dataset.single) { singles.push(c); return; }
      const k = c.dataset.group!;
      if (!byKey.has(k)) { byKey.set(k, []); groups.push(byKey.get(k)!); }
      byKey.get(k)!.push(c);
    });

    seq = [];
    const forceLeft = new Set<HTMLElement>();
    const numbered: { cells: HTMLElement[]; shoot: boolean }[] = [];
    let used = 0;
    for (const g of groups) {
      if (used > 0 && used + g.length > cols) {
        while (used < cols && singles.length) {
          const s = singles.shift()!;
          seq.push(s); numbered.push({ cells: [s], shoot: false }); used++;
        }
        if (used < cols) forceLeft.add(g[0]);
        used = 0;
      }
      seq.push(...g); numbered.push({ cells: g, shoot: true });
      used = (used + g.length) % cols;
    }
    singles.forEach((s) => { seq.push(s); numbered.push({ cells: [s], shoot: false }); });

    seq.forEach((c, i) => {
      c.style.order = String(i);
      c.style.gridColumnStart = forceLeft.has(c) ? '1' : '';
    });
    numbered.forEach((n, gi) => n.cells.forEach((c, k) => {
      const el = c.querySelector('.ix-num');
      if (el) el.textContent = n.shoot ? `${pad2(gi + 1)}.${k + 1}` : pad2(gi + 1);
    }));
  }

  let lastCols = 0;
  window.addEventListener('resize', () => {
    const cols = grid ? getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length : 0;
    if (cols !== lastCols) { lastCols = cols; pack(); }
  });

  // ─── Filters: show only the chosen category, packed tight ──
  function setFilter(f: string, updateHash = true) {
    active = valid.includes(f) ? f : 'all';
    cells.forEach((c) => { c.hidden = active !== 'all' && c.dataset.category !== active; });
    filters.forEach((b) => {
      const on = b.dataset.filter === active;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    pack();
    if (updateHash) history.replaceState(null, '', active === 'all' ? location.pathname : '#' + active);
  }
  filters.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.filter || 'all')));
  setFilter(location.hash.slice(1) || 'all', false);

  // ─── Intro: title card → header logo ──────────
  // 1. Card builds in (CSS, ~0.9s).  2. Rule + tagline fade out.
  // 3. MGC flies into the header slot (transform only, eased in-out).
  // 4. It lands; header text fades in; only THEN does the black lift off the photos.
  (function intro() {
    const root = document.documentElement;
    if (!root.classList.contains('play-intro')) return;
    const overlay = document.getElementById('intro');
    const bg = overlay?.querySelector<HTMLElement>('.intro-bg');
    const big = document.getElementById('intro-mgc');
    const small = document.getElementById('brand-mark');
    if (!overlay || !bg || !big || !small) { root.classList.remove('play-intro'); return; }
    try { sessionStorage.setItem('mgc-intro', '1'); } catch (e) {}

    const EASE_OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
    const EASE_MOVE = 'cubic-bezier(0.65, 0, 0.35, 1)';
    const headerBits = Array.from(document.querySelectorAll<HTMLElement>('#site-nav .brand-line, #site-nav .nav-links'));

    let done = false;
    const anims: Animation[] = [];
    const run = (el: Element, k: Keyframe[], o: KeyframeAnimationOptions) => {
      const a = el.animate(k, { fill: 'forwards', ...o });
      anims.push(a);
      return a.finished;
    };
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    function finish() {
      if (done) return;
      done = true;
      root.classList.remove('play-intro', 'intro-go', 'intro-reveal');
      overlay!.remove();
      anims.forEach((a) => a.cancel());
    }
    overlay.addEventListener('click', finish);
    window.addEventListener('keydown', finish, { once: true });
    window.addEventListener('wheel', finish, { once: true, passive: true });
    window.addEventListener('touchmove', finish, { once: true, passive: true });

    const fontsReady = Promise.race([document.fonts?.ready ?? Promise.resolve(), wait(900)]);

    const nextFrame = () => new Promise((r) => requestAnimationFrame(() => r(null)));

    (async () => {
      // 1. Let the page finish its first heavy frames, then build the card.
      await fontsReady;
      await Promise.race([new Promise((r) => (window as any).requestIdleCallback ? (window as any).requestIdleCallback(r, { timeout: 400 }) : setTimeout(r, 120)), wait(400)]);
      await nextFrame(); await nextFrame();
      if (done) return;
      root.classList.add('intro-go');
      await wait(1450);
      if (done) return;

      // 2. Clear the supporting lines so the move is just the wordmark.
      overlay.querySelectorAll<HTMLElement>('.intro-rule, .intro-sub').forEach((el) => {
        el.style.animation = 'none';
        run(el, [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-6px)' }],
          { duration: 220, easing: EASE_OUT });
      });
      await wait(160);
      if (done) return;

      // 3. Fly: one compositor-only transform from card position to header slot.
      big.style.animation = 'none';
      const from = big.getBoundingClientRect();
      const to = small.getBoundingClientRect();
      const scale = to.height / from.height;
      const dx = to.left - from.left;
      const dy = to.top - from.top;
      await run(big, [
        { transform: 'translate3d(0, 0, 0) scale(1)' },
        { transform: `translate3d(${dx}px, ${dy}px, 0) scale(${scale})` },
      ], { duration: 950, easing: EASE_MOVE });
      if (done) return;

      // 4. Land: swap to the real header logo in the same frame, then reveal.
      small.style.opacity = '1';
      big.style.visibility = 'hidden';
      root.classList.add('intro-reveal');
      // The grid paints now, while nothing is moving; fades start after it.
      await nextFrame(); await nextFrame();
      if (done) return;
      headerBits.forEach((el, i) =>
        run(el, [{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: i * 70, easing: EASE_OUT }));
      await run(bg, [{ opacity: 1 }, { opacity: 0 }], { duration: 520, delay: 140, easing: EASE_OUT });
      small.style.opacity = '';
      finish();
    })().catch(finish);
  })();

  // ─── Lightbox ───────────────────────────────────
  const lb = document.getElementById('ix-lb') as HTMLElement;
  const lbImg = lb.querySelector('.ix-lb-img') as HTMLImageElement;
  const lbTitle = lb.querySelector('.ix-lb-title') as HTMLElement;
  const lbCount = lb.querySelector('.ix-lb-count') as HTMLElement;
  let order: HTMLElement[] = [];
  let pos = -1;
  let opener: HTMLElement | null = null;

  const items = () => seq.map((c) => c.querySelector('.ix-item') as HTMLElement);

  function show(i: number) {
    pos = (i + order.length) % order.length;
    const el = order[pos];
    lbImg.src = el.dataset.src || '';
    lbImg.alt = el.dataset.alt || '';
    lbTitle.textContent = `${el.dataset.title} — ${el.dataset.desc}`;
    lbCount.textContent = `${pos + 1} / ${order.length}`;
  }
  function open(el: HTMLElement) {
    order = items();
    opener = el;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    show(order.indexOf(el));
    (lb.querySelector('.ix-lb-close') as HTMLElement).focus();
  }
  function close() {
    lb.hidden = true;
    lbImg.removeAttribute('src');
    document.body.style.overflow = '';
    opener?.focus();
  }

  grid?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.ix-item');
    if (!el) return;
    open(el);
  });
  lb.querySelector('.ix-lb-prev')?.addEventListener('click', () => show(pos - 1));
  lb.querySelector('.ix-lb-next')?.addEventListener('click', () => show(pos + 1));
  lb.querySelector('.ix-lb-close')?.addEventListener('click', close);
  lbImg.addEventListener('click', () => show(pos + 1));
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(pos + 1);
    if (e.key === 'ArrowLeft') show(pos - 1);
  });

  // Swipe on phones
  let x0: number | null = null;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) show(pos + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>

<style>
  /* ─── Head ───────────────────────────────────── */
  .ix-head {
    padding: 104px 5px 20px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
    align-items: end;
  }
  .ix-bio { grid-column: 1 / span 3; }
  .ix-lead {
    font-family: var(--font-family-brand);
    font-weight: 500;
    font-size: clamp(22px, 2.3vw, 34px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    text-transform: none;
    text-wrap: balance;
    color: var(--color-text);
    max-width: 34ch;
  }
  .ix-sub {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-top: 18px;
    color: var(--color-muted);
  }
  .ix-sub a { color: var(--color-text); }
  .ix-avail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    color: var(--color-text);
  }
  .ix-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00d0bf;
    box-shadow: 0 0 6px #00d0bf88;
    flex-shrink: 0;
    animation: avail-pulse 2.5s ease infinite;
  }
  @keyframes avail-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .ix-dot { animation: none; } }
  .ix-sub a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ─── Intro ──────────────────────────────────── */
  /* Sits under the header (z 100) so the logo can dock into its slot;
     header text and the photos stay hidden until the logo has landed. */
  .intro { display: none; }
  :global(html.play-intro) .intro {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 90;
    cursor: pointer;
  }
  .intro-bg {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    will-change: opacity;
  }
  :global(html.play-intro body) { overflow: hidden; }
  /* Don't paint the photo grid behind the card; it's revealed after the logo lands. */
  :global(html.play-intro:not(.intro-reveal) #main-content),
  :global(html.play-intro:not(.intro-reveal) footer) { visibility: hidden; }
  :global(html.play-intro) .intro { visibility: visible; }
  :global(html.play-intro #brand-mark),
  :global(html.play-intro #site-nav .brand-line),
  :global(html.play-intro #site-nav .nav-links) { opacity: 0; }
  .intro-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
  }
  .intro-mgc {
    font-family: var(--font-family-brand);
    font-weight: 800;
    font-size: clamp(96px, 16vw, 220px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--color-text);
    transform-origin: 0 0;
    will-change: transform;
    backface-visibility: hidden;
    opacity: 0;
  }
  .intro-rule {
    width: min(60vw, 420px);
    height: 1px;
    background: var(--color-muted);
    transform: scaleX(0);
  }
  .intro-sub {
    font-family: var(--font-family-brand);
    font-weight: 500;
    font-size: clamp(13px, 1.6vw, 22px);
    letter-spacing: 0.32em;
    margin-right: -0.32em;
    color: var(--color-text);
    opacity: 0;
  }
  /* The card only starts building once the page has settled (see script). */
  :global(html.intro-go) .intro-mgc { animation: intro-in 640ms cubic-bezier(0.23, 1, 0.32, 1) both; }
  :global(html.intro-go) .intro-rule { animation: rule-in 520ms 220ms cubic-bezier(0.23, 1, 0.32, 1) both; }
  :global(html.intro-go) .intro-sub { animation: sub-in 520ms 380ms cubic-bezier(0.23, 1, 0.32, 1) both; }
  @keyframes intro-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes rule-in  { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes sub-in   { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .ix-filters {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 40px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }
  .ix-filter {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    background: none;
    border: 0;
    padding: 4px 0;
    color: var(--color-muted);
    cursor: pointer;
  }
  .ix-filter span { color: var(--color-faint); margin-left: 2px; }
  .ix-filter:hover { color: var(--color-text); }
  .ix-filter.is-active { color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }

  /* ─── Grid ───────────────────────────────────── */
  .ix-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px 5px;
    padding: 0 5px;
  }
  @media (min-width: 1200px) { .ix-grid { grid-template-columns: repeat(5, 1fr); } }

  .ix-cell { position: relative; }

  .ix-item {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    text-align: left;
    cursor: zoom-in;
  }

  .ix-frame {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .ix-frame img { width: 100%; height: 100%; object-fit: cover; }

  .ix-meta {
    display: grid;
    grid-template-columns: 3.2em 1fr auto;
    column-gap: 6px;
    padding: 6px 10px 0 0;
    font-size: 10.5px;
    line-height: 1.45;
  }
  .ix-num   { color: var(--color-faint); grid-row: span 2; }
  .ix-title { color: var(--color-text); }
  .ix-cat   { color: var(--color-faint); grid-column: 3; grid-row: 1; }
  .ix-desc  { color: var(--color-muted); grid-column: 2 / -1; }

  .ix-item:hover .ix-title,
  .ix-item:focus-visible .ix-title { text-decoration: underline; text-underline-offset: 3px; }

  .ix-cell[hidden] { display: none; }

  /* ─── About (below the work) ─────────────────── */
  .ix-about {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 5px;
    padding: 72px 5px 0;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .ix-about .ix-col:first-child { grid-column: span 2; padding-right: 2rem; }
  .ix-about p + p { margin-top: 0.8em; }
  .ix-about ul { list-style: none; }
  .ix-about li + li { margin-top: 0.4em; }
  .ix-label { color: var(--color-faint); margin-bottom: 0.8em; }
  .ix-about a { color: var(--color-text); }
  .ix-about a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ─── Lightbox ───────────────────────────────── */
  .ix-lb {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--color-bg);
    display: grid;
    grid-template-rows: 1fr auto;
  }
