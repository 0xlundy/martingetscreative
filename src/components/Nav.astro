---
const currentPath = Astro.url.pathname;
const isStory = /^\/(stories|editorial|personal)(\/|$)/.test(currentPath);
const links = [
  { href: '/',        label: 'Stills',  active: currentPath === '/' },
  { href: '/motion',  label: 'Motion',  active: currentPath.startsWith('/motion') },
  { href: '/stories', label: 'Stories', active: isStory },
];
---

<header id="site-nav">
  <nav class="nav-inner">

    <a href="/" class="brand" aria-label="MGC, Martin Van Londen: home">
      <span class="brand-mark" id="brand-mark">MGC</span>
      <span class="brand-line">
        <span class="brand-name">Martin Van Londen</span>
        <span class="brand-role">Photographer · Director of Photography</span>
      </span>
    </a>

    <ul class="nav-links" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['nav-link', { 'is-active': l.active }]}>{l.label}</a>
        </li>
      ))}
    </ul>

    <!-- Mobile toggle -->
    <button id="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>

  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" aria-hidden="true">
    {links.map((l) => <a href={l.href} class="mob-link">{l.label}</a>)}
  </div>
</header>

<script>
  const nav    = document.getElementById('site-nav');
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 60);
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.classList.toggle('is-open');
  });

  menu?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => {
      menu.classList.remove('is-open');
      toggle?.classList.remove('is-open');
    })
  );
</script>

<style>
  #site-nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    transition: background 300ms ease, border-color 300ms ease;
    border-bottom: 1px solid transparent;
  }

  #site-nav.is-scrolled {
    background: rgba(10,10,10,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--color-border);
  }

  .nav-inner {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 2rem;
    height: 76px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* ─── Brand: MGC wordmark + who/what ─── */
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
    min-width: 0;
  }
  .brand-mark {
    font-family: var(--font-family-brand);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--color-text);
    display: block;
  }
  .brand-line {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-left: 14px;
    border-left: 1px solid var(--color-border);
    font-size: 11px;
    line-height: 1.25;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }
  .brand-name { color: var(--color-text); }
  .brand-role { color: var(--color-muted); }

  .nav-logo {
    font-family: var(--font-family-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-family-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 150ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active { color: var(--color-text); }

  /* Hamburger */
  #menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  #menu-toggle span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 200ms ease, opacity 200ms ease;
  }

  #menu-toggle.is-open span:first-child { transform: translateY(3.25px) rotate(45deg); }
  #menu-toggle.is-open span:last-child  { transform: translateY(-3.25px) rotate(-45deg); }

  /* Mobile menu */
  #mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 2rem;
    gap: 0.125rem;
  }

  #mobile-menu.is-open { display: flex; }

  .mob-link {
    display: block;
    padding: 0.875rem 0;
    font-family: var(--font-family-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
    transition: color 150ms ease;
  }

  .mob-link:hover { color: var(--color-text); }

  /* Two links fit on any phone, so they stay visible (no hamburger). */
  /* Phones: logo + name on top, the three sections on a row below. */
  @media (max-width: 640px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      padding: 12px 1rem 10px;
      row-gap: 12px;
    }
    .brand-mark { font-size: 30px; }
    .brand-line { font-size: 10px; letter-spacing: 0.08em; }
    .nav-links { margin-left: 0; width: 100%; gap: 1.5rem; }
  }
</style>
